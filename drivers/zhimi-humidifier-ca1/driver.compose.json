{
  "name": {
    "en": "Mi Smart Humidifier",
    "nl": "Mi Smart luchtbevochtiger"
  },
  "class": "humidifier",
  "capabilities": [
    "onoff",
    "humidifier_mode",
    "humidifier_target_humidity",
    "humidifier_dry",
    "measure_humidity",
    "measure_temperature",
    "led_display",
    "buzzer_enabled",
    "locked"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "icon": "{{driverAssetsPath}}/icon.svg",
  "pair": [
    {
      "id": "pair"
    }
  ],
  "settings": [
    {
      "id": "address",
      "type": "text",
      "label": {
        "en": "IP address",
        "nl": "IP-adres"
      },
      "value": ""
    },
    {
      "id": "token",
      "type": "text",
      "label": {
        "en": "Device token",
        "nl": "Apparaattoken"
      },
      "value": ""
    },
    {
      "id": "polling",
      "type": "number",
      "label": {
        "en": "Polling interval (seconds)",
        "nl": "Pollinginterval (seconden)"
      },
      "min": 5,
      "max": 3600,
      "value": 10
    }
  ]
}
